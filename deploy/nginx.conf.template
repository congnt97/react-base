server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  include /etc/nginx/snippets/security-headers.conf;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;
  gzip_min_length 1024;

  location = /healthz {
    return 200 'ok';
    add_header Content-Type text/plain;
  }

  # Proxy API cùng origin để tránh CORS. Upstream đổi lúc runtime qua env API_UPSTREAM.
  # Dùng biến + resolver để nginx không resolve host lúc khởi động (backend chưa lên
  # hoặc chạy standalone vẫn start được). NGINX_LOCAL_RESOLVERS do image nginx set từ
  # /etc/resolv.conf. Path /api/... được giữ nguyên; nếu backend không có prefix /api,
  # thêm `rewrite ^/api/(.*)$ /$1 break;` trước proxy_pass.
  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Asset có hash trong tên: cache dài hạn.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA fallback; index.html không cache để deploy mới có hiệu lực ngay.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
