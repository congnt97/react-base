{
  "colors": {
    "appBg": "#f8fafc",
    "contentBg": "#ffffff",
    "sidebarBg": "#0f172a",
    "borderSubtle": "#e2e8f0",
    "borderStrong": "#cbd5e1",
    "textMain": "#0f172a",
    "textMuted": "#64748b",
    "primary": "#2563eb",
    "link": "#1d4ed8",
    "success": "#166534",
    "successBg": "#dcfce7",
    "warning": "#92400e",
    "warningBg": "#fef3c7",
    "danger": "#dc2626",
    "dangerBg": "#fee2e2"
